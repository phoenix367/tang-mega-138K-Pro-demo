/dts-v1/;

/*
 * Linux + OpenSBI device tree for the Gowin AE350 (Tang Mega 138K Pro Dock).
 * Self-contained (no U-Boot includes). Differences vs our U-Boot DT:
 *   - riscv,isa = "rv32imafdc"  (expose the FPU; userspace is ilp32d)
 *   - chosen/bootargs carry earlycon + console for the 8250 at 0xf0300020
 * OpenSBI (generic) keys off: andestech,plmt0 (M-mode timer), andestech,plicsw
 * (IPI), riscv,plic0 (irqchip), ns16550a (console). 50 MHz APB/timer clocks.
 */

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	compatible = "andestech,a25";	/* NOT andestech,ae350 -> that override resets this SoC */
	model = "Gowin AE350 (Tang Mega 138K Pro)";

	aliases {
		serial0 = &serial0;
	};

	chosen {
		/* no_hash_pointers: this SoC has no HW RNG, so the kernel's %p
		 * pointer-hash key never seeds and /proc/net/* prints "(ptrval)",
		 * which breaks netstat/ss parsing. Print real pointers instead
		 * (acceptable on a dev board). */
		bootargs = "console=ttyS0,115200n8 earlycon=uart8250,mmio32,0xf0300020 loglevel=8 no_hash_pointers";
		stdout-path = "/soc/serial@f0300000:115200n8";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <50000000>;	/* PLMT mtime = 50 MHz */
		CPU0: cpu@0 {
			device_type = "cpu";
			reg = <0>;
			status = "okay";
			compatible = "riscv";
			riscv,isa = "rv32imafdc";	/* FPU present (misa IMAFDC) */
			mmu-type = "riscv,sv32";
			clock-frequency = <800000000>;
			i-cache-size = <0x8000>;
			i-cache-line-size = <32>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <32>;
			CPU0_intc: interrupt-controller {
				#interrupt-cells = <1>;
				interrupt-controller;
				compatible = "riscv,cpu-intc";
			};
		};
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>;		/* 256 MB DDR3 */
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges;

		plic0: interrupt-controller@e4000000 {
			compatible = "andestech,nceplic100", "riscv,plic0";
			#interrupt-cells = <2>;
			interrupt-controller;
			reg = <0xe4000000 0x2000000>;
			riscv,ndev = <71>;
			interrupts-extended = <&CPU0_intc 11 &CPU0_intc 9>;
		};

		plicsw: interrupt-controller@e6400000 {
			compatible = "andestech,plicsw";
			#interrupt-cells = <1>;
			interrupt-controller;
			reg = <0xe6400000 0x400000>;
			riscv,ndev = <2>;
			interrupts-extended = <&CPU0_intc 3>;
		};

		plmt0@e6000000 {
			compatible = "andestech,plmt0";
			interrupts-extended = <&CPU0_intc 7>;
			reg = <0xe6000000 0x100000>;
		};

		serial0: serial@f0300000 {
			compatible = "andestech,uart16550", "ns16550a";
			reg = <0xf0300000 0x1000>;
			interrupts = <9 4>;
			interrupt-parent = <&plic0>;
			clock-frequency = <50000000>;	/* APB = 50 MHz */
			current-speed = <115200>;
			reg-shift = <2>;
			reg-offset = <32>;		/* 0x20 */
			no-loopback-test = <1>;
		};

		/* RGB LCD scan-out core (video/rtl), Sipeed 5" 800x480, DE mode */
		lcd0: lcd@e8001000 {
			compatible = "gowin,ae350-lcd";
			reg = <0xe8001000 0x100>;
			width = <800>;
			height = <480>;
			hfront-porch = <210>;
			hback-porch = <182>;
			vfront-porch = <45>;
			vback-porch = <8>;
		};

		gmac0: ethernet@e8000000 {
			compatible = "gowin,ae350-tse";
			reg = <0xe8000000 0x800>;
			interrupts = <4 4>;	/* EXT_INT[0] = GP0 = PLIC src 4 */
			interrupt-parent = <&plic0>;
			phy-mode = "rgmii-id";	/* RGMII delay supplied by the PHY */
			phy-handle = <&phy0>;

			mdio {
				#address-cells = <1>;
				#size-cells = <0>;
				phy0: ethernet-phy@0 {
					reg = <0>;	/* RTL8211-class, MDIO addr 0 */
				};
			};
		};

		/*
		 * System reset (so `reboot` works). OpenSBI's generic platform has
		 * an atcwdt200 reset driver: on SBI cold-reboot it programs the SMU
		 * per-hart reset vector to the flash XIP base (0x80000000) then arms
		 * the ATCWDT200 watchdog -> SoC reset -> re-runs U-Boot.
		 *   - The SMU node's reg is the SMU base; its atcsmu-hsm child is what
		 *     the OpenSBI HSM driver matches to learn that base (atcsmu_base).
		 *   - The watchdog node is what the reset driver matches.
		 * The Linux kernel has no atcwdt200 driver, so it ignores both nodes.
		 */
		smu@f0100000 {
			compatible = "andestech,atcsmu";
			reg = <0xf0100000 0x1000>;
			hsm {
				compatible = "andestech,atcsmu-hsm";
			};
		};

		watchdog@f0500000 {
			compatible = "andestech,atcwdt200";
			reg = <0xf0500000 0x1000>;
		};
	};
};
