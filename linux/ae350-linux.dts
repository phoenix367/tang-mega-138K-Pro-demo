/dts-v1/;

/*
 * Linux + OpenSBI device tree for the Gowin AE350 (Tang Mega 138K Pro Dock).
 * Self-contained (no U-Boot includes). Differences vs our U-Boot DT:
 *   - riscv,isa = "rv32imafdc"  (expose the FPU; userspace is ilp32d)
 *   - chosen/bootargs carry earlycon + console for the 8250 at 0xf0300020
 *     (console=tty0 too: the boot log also goes to fbcon on the LCD; ttyS0
 *     stays last, so /dev/console is the UART)
 * OpenSBI (generic) keys off: andestech,plmt0 (M-mode timer), andestech,plicsw
 * (IPI), riscv,plic0 (irqchip), ns16550a (console). 50 MHz APB/timer clocks.
 */

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	compatible = "andestech,a25";	/* NOT andestech,ae350 -> that override resets this SoC */
	model = "Gowin AE350 (Tang Mega 138K Pro)";

	aliases {
		serial0 = &serial0;
	};

	chosen {
		/* no_hash_pointers: this SoC has no HW RNG, so the kernel's %p
		 * pointer-hash key never seeds and /proc/net/* prints "(ptrval)",
		 * which breaks netstat/ss parsing. Print real pointers instead
		 * (acceptable on a dev board). */
		bootargs = "console=tty0 console=ttyS0,115200n8 earlycon=uart8250,mmio32,0xf0300020 loglevel=8 no_hash_pointers";
		stdout-path = "/soc/serial@f0300000:115200n8";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <50000000>;	/* PLMT mtime = 50 MHz */
		CPU0: cpu@0 {
			device_type = "cpu";
			reg = <0>;
			status = "okay";
			compatible = "riscv";
			riscv,isa = "rv32imafdc";	/* FPU present (misa IMAFDC) */
			mmu-type = "riscv,sv32";
			clock-frequency = <800000000>;
			i-cache-size = <0x8000>;
			i-cache-line-size = <32>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <32>;
			CPU0_intc: interrupt-controller {
				#interrupt-cells = <1>;
				interrupt-controller;
				compatible = "riscv,cpu-intc";
			};
		};
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x40000000>;		/* 1 GB DDR3 (2 x16 chips, 32-bit bus, 15 row bits) */
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges;

		plic0: interrupt-controller@e4000000 {
			compatible = "andestech,nceplic100", "riscv,plic0";
			#interrupt-cells = <2>;
			interrupt-controller;
			reg = <0xe4000000 0x2000000>;
			riscv,ndev = <71>;
			interrupts-extended = <&CPU0_intc 11 &CPU0_intc 9>;
		};

		plicsw: interrupt-controller@e6400000 {
			compatible = "andestech,plicsw";
			#interrupt-cells = <1>;
			interrupt-controller;
			reg = <0xe6400000 0x400000>;
			riscv,ndev = <2>;
			interrupts-extended = <&CPU0_intc 3>;
		};

		plmt0@e6000000 {
			compatible = "andestech,plmt0";
			interrupts-extended = <&CPU0_intc 7>;
			reg = <0xe6000000 0x100000>;
		};

		serial0: serial@f0300000 {
			compatible = "andestech,uart16550", "ns16550a";
			reg = <0xf0300000 0x1000>;
			interrupts = <9 4>;
			interrupt-parent = <&plic0>;
			clock-frequency = <50000000>;	/* APB = 50 MHz */
			current-speed = <115200>;
			reg-shift = <2>;
			reg-offset = <32>;		/* 0x20 */
			no-loopback-test = <1>;
		};

		/* RGB LCD scan-out core (video/rtl), Sipeed 5" 800x480, DE mode */
		lcd0: lcd@e8001000 {
			compatible = "gowin,ae350-lcd";
			reg = <0xe8001000 0x100>;
			width = <800>;
			height = <480>;
			hfront-porch = <210>;
			hback-porch = <182>;
			vfront-porch = <45>;
			vback-porch = <8>;
		};

		/* audio out: FIFO + serialiser for the Dock's PT8211 16-bit stereo DAC
		 * (BCK E22, WS F24, DIN G24 -> headphone jack / speaker); EXTS window
		 * 0xE8002000, EXT_INT[1] = GP1 = PLIC src 11 (FIFO below threshold; GP0 = 4, GP1..15 = 11..25) */
		audio0: audio@e8002000 {
			compatible = "gowin,ae350-pt8211";
			reg = <0xe8002000 0x100>;
			interrupts = <11 4>;
			interrupt-parent = <&plic0>;
		};

		/* sensor/ -- on-die temperature (ADCLRC) + supply voltages (ADCULC),
		 * free-running scan; hwmon driver gowin-adc (no interrupt) */
		sensor0: sensor@e8004000 {
			compatible = "gowin,ae350-adc";
			reg = <0xe8004000 0x100>;
		};

		/* fan/ -- Dock fan header M1: PWM (T17) + tacho (T18); hwmon driver
		 * gowin-fan.  Dock rev 4071f switches the fan's 5 V through a
		 * P-MOSFET from the PWM pin: add gowin,pwm-inverted; there. */
		fan0: fan@e8008000 {
			compatible = "gowin,ae350-fan";
			reg = <0xe8008000 0x100>;
			clock-frequency = <50000000>;
			gowin,pulses-per-rev = <2>;
		};

		/* gpio/ -- six board-control lines behind a plain data/direction
		 * register pair (generic gpio-mmio): 0 SYS_TWI SCL (K25), 1 SDA (K26),
		 * 2..4 the Dock's 74HC4051 TWI mux select (N19/P19/P26), 5 EEPROM
		 * write protect (V14).  No board driver: i2c-gpio bit-bangs the bus,
		 * i2c-mux-gpio steers the mux, nvmem/at24 own the write protect. */
		bgpio: gpio@e8010000 {
			compatible = "wd,mbl-gpio";
			reg = <0xe8010000 0x4>, <0xe8010004 0x4>;
			reg-names = "dat", "dirout";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <6>;
			gpio-line-names = "sys-scl", "sys-sda", "twi-sel0", "twi-sel1",
					  "twi-sel2", "eeprom-wp";
		};

		/* sdhost/ -- native 4-bit SD host with DMA for the Dock's microSD
		 * slot J19 (CLK D23, CMD D24, DAT0..3 H23/J23/A25/B25), EXT_INT[2] =
		 * GP2 = PLIC src 12; MMC host driver gowin-sdhost -> /dev/mmcblk0. */
		sdhost0: mmc@e8020000 {
			compatible = "gowin,ae350-sdhost";
			reg = <0xe8020000 0x100>;
			clock-frequency = <50000000>;
			interrupts = <12 4>;
			interrupt-parent = <&plic0>;
			bus-width = <4>;
			max-frequency = <25000000>;
		};

		gmac0: ethernet@e8000000 {
			compatible = "gowin,ae350-tse";
			reg = <0xe8000000 0x800>;
			/* MAC from the board EEPROM (boardcfg set mac ...); the driver
			 * defers its probe until the EEPROM is up, random if unset */
			nvmem-cells = <&eth_mac>;
			nvmem-cell-names = "mac-address";
			interrupts = <4 4>;	/* EXT_INT[0] = GP0 = PLIC src 4 */
			interrupt-parent = <&plic0>;
			phy-mode = "rgmii-id";	/* RGMII delay supplied by the PHY */
			phy-handle = <&phy0>;

			mdio {
				#address-cells = <1>;
				#size-cells = <0>;
				phy0: ethernet-phy@0 {
					reg = <0>;	/* RTL8211-class, MDIO addr 0 */
				};
			};
		};

		/*
		 * System reset (so `reboot` works). OpenSBI's generic platform has
		 * an atcwdt200 reset driver: on SBI cold-reboot it programs the SMU
		 * per-hart reset vector to the flash XIP base (0x80000000) then arms
		 * the ATCWDT200 watchdog -> SoC reset -> re-runs U-Boot.
		 *   - The SMU node's reg is the SMU base; its atcsmu-hsm child is what
		 *     the OpenSBI HSM driver matches to learn that base (atcsmu_base).
		 *   - The watchdog node is what the reset driver matches.
		 * The Linux kernel has no atcwdt200 driver, so it ignores both nodes.
		 */
		smu@f0100000 {
			compatible = "andestech,atcsmu";
			reg = <0xf0100000 0x1000>;
			hsm {
				compatible = "andestech,atcsmu-hsm";
			};
		};

		watchdog@f0500000 {
			compatible = "andestech,atcwdt200";
			reg = <0xf0500000 0x1000>;
		};
	};

	/* Off the soc bus: these two have no registers of their own. */
	/* The Dock's SYS_TWI bus (2.2k pull-ups), ~100 kHz.  Flag 6 =
	 * GPIO_OPEN_DRAIN (SINGLE_ENDED 2 | LINE_OPEN_DRAIN 4): gpiolib emulates
	 * it on this chip by switching the direction (input = released,
	 * output-low = driven). */
	i2c_sys: i2c-sys {
		compatible = "i2c-gpio";
		sda-gpios = <&bgpio 1 6>;
		scl-gpios = <&bgpio 0 6>;
		i2c-gpio,delay-us = <5>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	/* 8-way TWI mux (two 74HC4051, Dock sheet "TWI MUX"): 0/1 SFP0/1,
	 * 2 EEPROM, 3 DVI-A DDC, 4 DVI-B DDC, 5 DVP camera, 6/7 MIPI RX0/1.
	 * Each channel becomes its own i2c bus (/dev/i2c-1..); only the
	 * EEPROM is populated here.  Idle on the EEPROM channel. */
	i2c_mux: i2c-mux {
		compatible = "i2c-mux-gpio";
		i2c-parent = <&i2c_sys>;
		mux-gpios = <&bgpio 2 0>, <&bgpio 3 0>, <&bgpio 4 0>;
		idle-state = <2>;
		#address-cells = <1>;
		#size-cells = <0>;

		i2c_eeprom: i2c@2 {
			reg = <2>;
			#address-cells = <1>;
			#size-cells = <0>;

			/* ZD24C08A U24: 1 KB, 24C08-compatible (four 256-byte
			 * blocks at 0x50..0x53), 16-byte pages.  Hardware WP is
			 * held high by the nvmem core and dropped only for
			 * writes.  /sys/bus/nvmem/devices/board-eeprom0/nvmem */
			eeprom0: eeprom@50 {
				compatible = "atmel,24c08";
				reg = <0x50>;
				pagesize = <16>;
				wp-gpios = <&bgpio 5 0>;
				label = "board-eeprom";

				/* boardcfg(8) layout: 0x100 header, 0x110 MAC,
				 * 0x120.. key=value text (src/apps/boardcfg/) */
				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eth_mac: mac-address@110 {
						reg = <0x110 6>;
					};
				};
			};
		};

		i2c_dvi_a: i2c@3 {
			reg = <3>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c_dvi_b: i2c@4 {
			reg = <4>;
			#address-cells = <1>;
			#size-cells = <0>;
		};
	};
};
