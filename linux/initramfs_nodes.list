# Static device nodes for the initramfs so the kernel can open /dev/console
# for the init process before /init runs (avoids "unable to open an initial
# console" and lets the busybox banner/shell reach the UART).
nod /dev/console 0600 0 0 c 5 1
nod /dev/null    0666 0 0 c 1 3
nod /dev/tty     0666 0 0 c 5 0
nod /dev/ttyS0   0600 0 0 c 4 64
nod /dev/kmsg    0644 0 0 c 1 11
