#!/bin/busybox sh
# /etc/init.d/S70desktop -- LVGL desktop on the LCD (/dev/fb0, VT 1).
# A supervisor loop restarts lvdesk if it exits; "S70desktop stop" ends both.
# Only one desktop can run: "start" refuses while a supervisor is alive, and
# lvdesk itself holds an exclusive lock on /run/lvdesk.lock (exit code 3 when
# another copy has it, which also ends the loop instead of retrying forever).
# Disable at boot by creating /etc/nodesktop (not persistent: RAM rootfs).

PIDF=/run/desktop.pid

case "$1" in
	start)
		[ -e /etc/nodesktop ] && exit 0
		if [ -f $PIDF ] && kill -0 "$(cat $PIDF)" 2>/dev/null; then
			echo "desktop: already running (supervisor pid $(cat $PIDF))"
			exit 0
		fi
		rm -f /run/desktop.stop
		(
			while :; do
				lvdesk >/run/desktop.log 2>&1
				rc=$?
				[ -e /run/desktop.stop ] && break
				[ $rc -eq 3 ] && break	# another lvdesk holds the lock
				sleep 2
			done
		) &
		echo $! > $PIDF
		echo "desktop: lvdesk on /dev/fb0 (log /run/desktop.log)"
		;;
	stop)
		touch /run/desktop.stop
		[ -f $PIDF ] && kill "$(cat $PIDF)" 2>/dev/null
		killall lvdesk 2>/dev/null
		rm -f $PIDF
		;;
	restart|reload)
		"$0" stop
		sleep 1
		"$0" start
		;;
	*)
		echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
