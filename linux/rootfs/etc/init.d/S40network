#!/bin/busybox sh
# /etc/init.d/S40network -- loopback + Ethernet.
# Static IP for now; for DHCP replace the eth0 line with: udhcpc -i eth0 -b

case "$1" in
	start)
		ifconfig lo up
		ifconfig eth0 192.168.200.2 netmask 255.255.255.0 up
		echo "net: lo=127.0.0.1  eth0=192.168.200.2/24"
		;;
	stop)
		ifconfig eth0 down
		ifconfig lo down
		;;
	restart|reload)
		"$0" stop
		"$0" start
		;;
	*)
		echo "usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
