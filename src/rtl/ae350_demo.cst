// Fan header M1 (Fan_CPU_4pin) on the Dock: PWM T17 (IOR8A), tacho T18 (IOR8B),
// bank 2 (3.3 V).  Tacho is the fan's open collector with R26 10k to +3V3.
IO_LOC "FAN_PWM"  T17;
IO_LOC "FAN_TACH" T18;
IO_PORT "FAN_PWM"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "FAN_TACH" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// microSD slot J19 (Dock sheet FPGA_STORAGE), native SD bus.  Both Dock
// revisions (4071d/f) use these pins; 10k pull-ups and ESD clamps on the Dock,
// CLK has a 22R series resistor.  CLK/CMD/DAT2/DAT3 bank 5, DAT0/DAT1 bank 4,
// DET bank 2 (all 3.3 V).
IO_LOC "SD_CLK"    D23;
IO_LOC "SD_CMD"    D24;
IO_LOC "SD_DAT[0]" H23;
IO_LOC "SD_DAT[1]" J23;
IO_LOC "SD_DAT[2]" A25;
IO_LOC "SD_DAT[3]" B25;
IO_LOC "SD_DET"    J15;
IO_PORT "SD_CLK"    IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "SD_CMD"    IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "SD_DAT[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "SD_DAT[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "SD_DAT[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "SD_DAT[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "SD_DET"    IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// Board control lines (gpio_core @ 0xE8010000, Dock sheets "TWI MUX" and
// "SDIO & M.2"): SYS_TWI I2C bus K25/K26 (2.2k pull-ups R229/R230 on the
// Dock) feeding the two 74HC4051 TWI muxes selected by N19/P19/P26
// (channel 2 = ZD24C08A EEPROM U24, 3/4 = DVI DDC, 0/1 SFP, 5 camera,
// 6/7 MIPI RX); EEPROM write protect V14 (IOR11B).  All 3.3 V.
IO_LOC "SYS_SCL"    K25;
IO_LOC "SYS_SDA"    K26;
