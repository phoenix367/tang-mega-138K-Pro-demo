//Audio: PT8211 DAC on the Dock (pins + drive from TangMega-138KPro-example audio/audio_music)
IO_LOC "I2S_BCK"  E22;
IO_LOC "I2S_LRCK" F24;
IO_LOC "I2S_DIN"  G24;
IO_LOC "PA_EN"    H17;
IO_PORT "I2S_BCK"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "I2S_LRCK" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
