/impl/gwsynthesis/
/impl/pnr/
/impl/temp/
*.fs
*.pr
# keep impl/mega_138K_test_process_config.json (tracked: it is source config)

# --- IDE per-user state ---
*.gprj.user

# --- CMake / app build ---
/build/

# --- Firmware build artifacts (keep sources) ---
/firmware/build/

# --- Generated payload binaries (keep payload*.c/.ld/Makefile) ---
/payload/*.bin
/payload/*.elf

# --- Simulation output ---
*.vvp
*.vcd
*.fst

# --- Editor / misc ---
__pycache__/
*.swp
*~

# --- Gowin IP-generation intermediates (regenerated by IP wizard) ---
/src/*/temp/
/eth_dma/arb_sim/

# --- Debug captures (transient artifacts) ---
*.pcap

# --- tests/ build products (rebuild with tests/Makefile) ---
/tests/atomic_test
/tests/memthroughput
/tests/compute_bench
/tests/dsp_probe
/tests/ext_probe
/tests/amo_probe
/tests/cctl_probe
