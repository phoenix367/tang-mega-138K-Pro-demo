+/*
+ * Gowin AE350 (Andes A25) workaround: this SoC has no coherency agent
+ * (mcache_ctl.DC_COHEN is hardwired 0), so AMO / LR-SC exclusive accesses to
+ * DRAM never get a bus grant -- amoswap hangs and sc never succeeds. The system
+ * is single-hart, so the only concurrency is with traps/interrupts. We therefore
+ * implement every read-modify-write as an interrupt-disabled (mstatus.MIE=0)
+ * plain load/store, which is atomic w.r.t. this hart's traps. No hardware
+ * atomics are emitted from this file. See CACHE_ISSUES.md.
+ */
+
+static inline unsigned long __amo_irq_save(void)
+{
+	unsigned long s;
+	__asm__ __volatile__("csrrc %0, mstatus, %1"
+			     : "=r"(s)
+			     : "r"((unsigned long)MSTATUS_MIE)
+			     : "memory");
+	return s & MSTATUS_MIE;
+}
+
+static inline void __amo_irq_restore(unsigned long s)
+{
+	__asm__ __volatile__("csrrs x0, mstatus, %0" :: "r"(s) : "memory");
+}
 
